{
  "name": "@perpes/evm-liquidity-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Sophisticated Monad liquidity and bootstrap trading bot for Perpes.fun",
  "scripts": {
    "build": "tsc",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "dev:testnet": "dotenv -e ../../.env -- tsx watch src/index.ts --mode testnet",
    "dev:mainnet": "dotenv -e ../../.env -- tsx watch src/index.ts --mode mainnet",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@perpes/evm": "workspace:*",
    "@perpes/offchain": "workspace:*",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "viem": "2.47.4"
  },
  "devDependencies": {
    "@perpes/config": "workspace:*",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
